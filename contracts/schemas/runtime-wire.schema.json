{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veyra.local/contracts/runtime-wire.schema.json",
  "title": "Veyra Runtime Event and Command V1",
  "$defs": {
    "uuid7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "node_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
    "json_value": {"anyOf": [{"type": "null"}, {"type": "string"}, {"type": "number"}, {"type": "boolean"}, {"type": "array", "items": {"$ref": "#/$defs/json_value"}}, {"type": "object", "additionalProperties": {"$ref": "#/$defs/json_value"}}]},
    "payload": {"type": "object", "additionalProperties": {"$ref": "#/$defs/json_value"}},
    "run_event": {"type": "object", "additionalProperties": false, "required": ["schema_version", "event_id", "run_id", "timestamp", "sequence", "kind", "node_id", "payload"], "properties": {"schema_version": {"const": "1.0"}, "event_id": {"$ref": "#/$defs/uuid7"}, "run_id": {"$ref": "#/$defs/uuid7"}, "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"}, "sequence": {"type": "integer", "minimum": 1}, "kind": {"enum": ["run.created", "run.started", "run.completed", "run.failed", "run.cancelled", "node.started", "node.output", "node.waiting", "node.failed", "node.completed", "verifier.result"]}, "node_id": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/node_id"}]}, "payload": {"$ref": "#/$defs/payload"}}, "allOf": [{"if": {"properties": {"kind": {"enum": ["run.created", "run.started", "run.completed", "run.failed", "run.cancelled"]}}}, "then": {"properties": {"node_id": {"const": null}}}}, {"if": {"properties": {"kind": {"enum": ["node.started", "node.output", "node.waiting", "node.failed", "node.completed", "verifier.result"]}}}, "then": {"properties": {"node_id": {"$ref": "#/$defs/node_id"}}}}]},
    "run_command": {"type": "object", "additionalProperties": false, "required": ["schema_version", "command_id", "run_id", "idempotency_key", "kind", "node_id", "expected_revision", "payload"], "properties": {"schema_version": {"const": "1.0"}, "command_id": {"$ref": "#/$defs/uuid7"}, "run_id": {"$ref": "#/$defs/uuid7"}, "idempotency_key": {"$ref": "#/$defs/uuid7"}, "kind": {"enum": ["run.start", "run.cancel", "run.approve", "run.reject", "run.resume"]}, "node_id": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/node_id"}]}, "expected_revision": {"type": "integer", "minimum": 0}, "payload": {"$ref": "#/$defs/payload"}}, "allOf": [{"if": {"properties": {"kind": {"enum": ["run.start", "run.cancel"]}}}, "then": {"properties": {"node_id": {"const": null}}}}, {"if": {"properties": {"kind": {"enum": ["run.approve", "run.reject", "run.resume"]}}}, "then": {"properties": {"node_id": {"$ref": "#/$defs/node_id"}}}}]}
  },
  "oneOf": [{"$ref": "#/$defs/run_event"}, {"$ref": "#/$defs/run_command"}]
}
