{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veyra.local/contracts/agent-semantic-plan.schema.json",
  "title": "AgentSemanticPlanV1",
  "description": "Provider-facing semantic plan. Models describe intent and optional step graph intent; Veyra compiles canonical objects. Do not emit node IDs, hashes, permissions, source.lock, or canvas positions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "goal",
    "suggested_name",
    "description",
    "inputs",
    "outputs",
    "steps",
    "capability_intents",
    "knowledge_intents",
    "approval_points",
    "success_criteria",
    "user_constraints"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "suggested_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "type": { "type": "string", "enum": ["string", "number", "boolean"] },
          "description": { "type": "string", "maxLength": 240 }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "type": { "type": "string", "enum": ["string", "number", "boolean"] },
          "description": { "type": "string", "maxLength": 240 }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "capability_intents": {
      "type": "array",
      "description": "Names of Project-bound tools only. Leave empty when no tool is required. Never copy policy sentences here.",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "knowledge_intents": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "approval_points": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "success_criteria": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "user_constraints": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "step_intents": {
      "type": "array",
      "description": "Optional duty graph. Omit only for a simple one-model Agent. Include one object per real duty. Use depends_on for order. The server compiles nodes and extra ports. Do not emit branches, node IDs, hashes, or canvas data.",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["semantic_key", "name", "purpose", "operation_kind"],
        "properties": {
          "semantic_key": { "type": "string", "minLength": 1, "maxLength": 64 },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "purpose": { "type": "string", "minLength": 1, "maxLength": 240 },
          "operation_kind": {
            "type": "string",
            "description": "model=LLM duty. capability=Project tool. transform=field mapping. condition=branch; server expands true/false. approval=human must confirm. verification=deterministic check such as non-empty output; do not invent a verifier implementation.",
            "enum": [
              "model",
              "capability",
              "transform",
              "condition",
              "approval",
              "verification"
            ]
          },
          "depends_on": {
            "type": "array",
            "description": "semantic_key values that must complete first.",
            "maxItems": 8,
            "items": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        }
      }
    }
  }
}
