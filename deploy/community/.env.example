# Copy this file to .env and fill every placeholder. Never commit .env.
VEYRA_BUILD_SHA=40-character-source-commit-sha
VEYRA_COMMUNITY_DOMAIN=community.example.com
VEYRA_COMMUNITY_ORIGIN=https://community.example.com

POSTGRES_DB=veyra_community
POSTGRES_USER=veyra
POSTGRES_PASSWORD=replace-with-a-long-postgres-password
# URL-encode reserved characters in the password in this URL.
VEYRA_COMMUNITY_DATABASE_URL=postgresql+psycopg://veyra:replace-with-a-long-postgres-password@postgres:5432/veyra_community

MINIO_BUCKET=veyra-community
MINIO_ROOT_USER=replace-with-a-minio-access-key
MINIO_ROOT_PASSWORD=replace-with-a-long-minio-secret
VEYRA_COMMUNITY_S3_REGION=us-east-1

VEYRA_AUTH_HMAC_SECRET=replace-with-at-least-32-random-bytes
VEYRA_COMMUNITY_REQUIRE_MODERATION=true
VEYRA_COMMUNITY_MODERATOR_HANDLES=moderator-handle

VEYRA_MAIL_SERVER=smtp.qq.com
VEYRA_MAIL_PORT=465
VEYRA_MAIL_USERNAME=replace-with-smtp-account
VEYRA_MAIL_PASSWORD=replace-with-smtp-password
VEYRA_MAIL_DEFAULT_SENDER=replace-with-sender-address
CADDY_EMAIL=replace-with-tls-contact-email
