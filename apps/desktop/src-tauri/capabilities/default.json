{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window may start the packaged Local sidecar and open validated HTTP(S) Community links in the system browser.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/veyra-local",
          "sidecar": true,
          "args": false
        }
      ]
    }
  ]
}
