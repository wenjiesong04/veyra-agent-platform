{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veyra.local/contracts/custom-component.schema.json",
  "title": "Veyra Custom Component V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "component_id",
    "project_id",
    "slug",
    "display_name",
    "description",
    "version",
    "inputs",
    "outputs",
    "implementation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "component_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,62}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 500
      }
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "string",
              "number",
              "integer",
              "boolean",
              "object",
              "array",
              "table",
              "image",
              "pdf",
              "document",
              "file",
              "audio",
              "video"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "artifact_kind": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "multiple": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "outputs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "string",
              "number",
              "integer",
              "boolean",
              "object",
              "array",
              "table",
              "image",
              "pdf",
              "document",
              "file",
              "audio",
              "video"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "artifact_kind": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "multiple": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "model_recipe",
            "tool_wrapper",
            "transform",
            "composite_graph"
          ]
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "model_ref": {
          "const": "model.primary"
        },
        "tool_reference": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*@[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "mapping": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "input_mapping": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "output_mapping": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "graph": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "component_type"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "component_type": { "type": "string", "minLength": 1 }
                }
              }
            },
            "transitions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from", "to", "port"],
                "properties": {
                  "from": { "type": "string", "minLength": 1 },
                  "to": { "type": "string", "minLength": 1 },
                  "port": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "content_hash"
        ],
        "properties": {
          "reference": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*@[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "required_permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_hosts",
        "tools"
      ],
      "properties": {
        "network_hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "filesystem_read_roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "filesystem_write_roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shell_workspace_only": {
          "type": "boolean"
        }
      }
    },
    "readiness": {
      "enum": [
        "ready",
        "requires_configuration",
        "design_only",
        "unavailable"
      ]
    },
    "provenance": {
      "enum": [
        "manual",
        "builder",
        "imported"
      ]
    },
    "lifecycle": {
      "enum": [
        "draft",
        "active",
        "deprecated"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
