{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veyra.local/contracts/project.vproject.schema.json",
  "title": "Veyra Project Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_version",
    "project_id",
    "name",
    "default_agent_id",
    "resource_policy",
    "agents"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_version": {
      "const": "1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "default_agent_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "resource_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_concurrent_runs",
        "max_nodes_per_run",
        "max_run_seconds"
      ],
      "properties": {
        "max_concurrent_runs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "max_nodes_per_run": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "max_run_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id",
          "slug",
          "path"
        ],
        "properties": {
          "agent_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "path": {
            "type": "string",
            "pattern": "^agents/[a-z][a-z0-9-]{0,62}$"
          },
          "parent_agent_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        }
      }
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_id",
          "slug",
          "version",
          "path"
        ],
        "properties": {
          "kind": {
            "const": "workflow"
          },
          "resource_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^workflows/[a-z][a-z0-9-]{0,62}$"
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_id",
          "slug",
          "version",
          "path",
          "component_class"
        ],
        "properties": {
          "kind": {
            "const": "component"
          },
          "resource_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^components/(primitive|composite)/[a-z][a-z0-9-]{0,62}$"
          },
          "component_class": {
            "enum": [
              "primitive",
              "composite"
            ]
          }
        }
      }
    },
    "knowledge": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_id",
          "slug",
          "version",
          "path"
        ],
        "properties": {
          "kind": {
            "const": "knowledge"
          },
          "resource_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^knowledge/[a-z][a-z0-9-]{0,62}$"
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_id",
          "slug",
          "version",
          "path"
        ],
        "properties": {
          "kind": {
            "const": "asset"
          },
          "resource_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^assets/[a-z][a-z0-9-]{0,62}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "agents": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "properties": {
          "default_agent_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "default_agent_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        }
      }
    }
  ]
}
