# Process-environment variable reference. Empty values are intentional.
# The applications may load the gitignored repo-root .env for local development;
# they never load a Project-directory .env automatically.

VEYRA_ENVIRONMENT=
VEYRA_APP_VERSION=
VEYRA_BUILD_SHA=

VEYRA_LOCAL_HOST=
VEYRA_LOCAL_PORT=
VEYRA_LOCAL_LOG_LEVEL=
VEYRA_LOCAL_DATABASE_URL=
VEYRA_LOCAL_MODE=

VEYRA_COMMUNITY_HOST=
VEYRA_COMMUNITY_PORT=
VEYRA_COMMUNITY_LOG_LEVEL=
VEYRA_COMMUNITY_MODE=
VEYRA_COMMUNITY_DATABASE_URL=

# Future Community delivery/storage/auth configuration. Keep values empty in
# this template; secrets belong in the process environment or secret store.
VEYRA_MAIL_SERVER=
VEYRA_MAIL_PORT=
VEYRA_MAIL_USE_SSL=
VEYRA_MAIL_USERNAME=
VEYRA_MAIL_PASSWORD=
VEYRA_MAIL_DEFAULT_SENDER=
VEYRA_OBJECT_STORE_ENDPOINT=
VEYRA_OBJECT_STORE_BUCKET=
VEYRA_OBJECT_STORE_REGION=
VEYRA_OBJECT_STORE_ACCESS_KEY=
VEYRA_OBJECT_STORE_SECRET_KEY=
VEYRA_AUTH_SESSION_SECRET=
VEYRA_AUTH_REFRESH_SECRET=
VEYRA_AUTH_SIGNING_KEY=

# Factory (Kimi K3) and local Runtime model. Put the real key in a gitignored
# repo-root `.env` or the process environment, never in this template.
# `veyra-local` loads the repo-root `.env` into the process; it never loads a
# Project-directory `.env`. Development may share MOONSHOT_API_KEY for Factory
# generation and Agent runs. Production/release does not use the host process
# key for user Agent runs.
VEYRA_FACTORY_MODEL_BASE_URL=
VEYRA_FACTORY_MODEL_ID=
VEYRA_FACTORY_MODEL_API_KEY_ENV=
VEYRA_RUNTIME_MODEL_BASE_URL=
VEYRA_RUNTIME_MODEL_ID=
VEYRA_RUNTIME_MODEL_API_KEY_ENV=
MOONSHOT_API_KEY=
