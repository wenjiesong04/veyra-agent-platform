{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veyra.local/contracts/evaluation-spec.schema.json",
  "title": "Veyra Private Result Evaluation Spec V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "version_id", "checks"],
  "properties": {
    "version": { "const": "1" },
    "version_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "checks": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/check" } }
  },
  "$defs": {
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "reference", "revision"],
      "properties": {
        "kind": { "enum": ["user", "fixture", "reference", "model"] },
        "reference": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" },
        "revision": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" }
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "required", "path", "method"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
        "label": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S" },
        "required": { "type": "boolean" },
        "path": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string" }, "prefixItems": [{ "type": "string", "pattern": "^(?!\\$)" }] },
        "method": { "enum": ["equals", "number_equals", "set_equals", "artifact_integrity", "human_review"] },
        "expected": true,
        "baseline": { "$ref": "#/$defs/baseline" }
      },
      "allOf": [
        {
          "if": { "properties": { "method": { "enum": ["equals", "number_equals", "set_equals"] } } },
          "then": { "required": ["expected", "baseline"] },
          "else": { "not": { "anyOf": [{ "required": ["expected"] }, { "required": ["baseline"] }] } }
        },
        { "if": { "properties": { "method": { "const": "number_equals" } } }, "then": { "properties": { "expected": { "type": "string" } } } },
        { "if": { "properties": { "method": { "const": "set_equals" } } }, "then": { "properties": { "expected": { "type": "array", "items": true } } } }
      ]
    }
  }
}
