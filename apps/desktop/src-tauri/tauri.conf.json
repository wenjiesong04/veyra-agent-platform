{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veyra Agent Platform",
  "version": "0.1.0",
  "identifier": "com.veyra.agentplatform",
  "build": {
    "beforeDevCommand": {
      "cwd": "../../../web",
      "script": "npm run dev --workspace=@veyra/desktop",
      "wait": false
    },
    "beforeBuildCommand": {
      "cwd": "../../../web",
      "script": "npm run build:desktop",
      "wait": true
    },
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../../web/apps/desktop/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Veyra Agent Platform",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true
      }
    ]
  },
  "plugins": {
    "shell": {
      "open": "https?://(?:\\[[0-9A-Fa-f:]+\\]|[A-Za-z0-9][A-Za-z0-9.-]*)(?::[0-9]{1,5})?(?:[/?#][^\\s]*)?"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/veyra-local"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
