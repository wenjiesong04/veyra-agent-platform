{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veyra.local/contracts/agent-source.schema.json",
  "title": "Veyra Agent Source V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "agentspec_version", "component_type", "id", "name", "description", "inputs", "outputs", "nodes", "transitions", "extensions", "ui", "lock"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "agentspec_version": {"const": "26.1"},
    "component_type": {"const": "Flow"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "inputs": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "outputs": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "nodes": {"type": "array", "minItems": 1},
    "transitions": {"type": "array"},
    "extensions": {"type": "object"},
    "ui": {"type": "object"},
    "lock": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
  }
}
