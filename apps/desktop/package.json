{
  "name": "@veyra/desktop-shell",
  "private": true,
  "version": "0.1.0",
  "productName": "Veyra Agent Platform",
  "description": "Electron shell for the Veyra local-first desktop application",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "python ../../scripts/build/package/package.py --run",
    "build:web": "npm --prefix ../../web run build:desktop",
    "build:sidecar": "python ../../scripts/build/package/build_sidecar.py",
    "package": "python ../../scripts/build/package/package.py",
    "package:smoke": "python ../../scripts/build/package/package_smoke.py --static-only"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0"
  }
}
