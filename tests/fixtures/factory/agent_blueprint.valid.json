{
  "schema_version": "factory.agent_blueprint.v1",
  "goal": "Prepare a verified research brief",
  "inputs": {
    "topic": {
      "type": "string",
      "required": true
    }
  },
  "nodes": [
    {
      "id": "start",
      "kind": "start"
    },
    {
      "id": "research",
      "kind": "agent",
      "component": "research"
    },
    {
      "id": "approval",
      "kind": "approval"
    },
    {
      "id": "verify",
      "kind": "verifier"
    },
    {
      "id": "output",
      "kind": "output"
    }
  ],
  "transitions": [
    {
      "from": "start",
      "to": "research"
    },
    {
      "from": "research",
      "to": "approval"
    },
    {
      "from": "approval",
      "to": "verify"
    },
    {
      "from": "verify",
      "to": "output"
    }
  ],
  "approval_points": ["approval"],
  "verification": {
    "required": true,
    "checks": ["output.has_source"]
  }
}
